const canvas = document.getElementById('board');
const ctx = canvas.getContext('2d');
const workspace = document.getElementById('workspace');
const zoomIndicator = document.getElementById('zoom-indicator');

window.workspaceScale = 1;
let panX = -(5000 - window.innerWidth) / 2;
let panY = -(5000 - window.innerHeight) / 2;

function updateTransform() {
    workspace.style.transform = `translate3d(${Math.round(panX)}px, ${Math.round(panY)}px, 0) scale(${window.workspaceScale})`;
    if (zoomIndicator) {
        zoomIndicator.innerText = Math.round(window.workspaceScale * 100) + '%';
    }
}
updateTransform();

window.centerWorkspace = function() {
    window.workspaceScale = 1;
    panX = -(5000 - window.innerWidth) / 2;
    panY = -(5000 - window.innerHeight) / 2;
    updateTransform();
};

let drawing = false;
let isPanning = false;
let spacePressed = false;
let panStartX = 0;
let panStartY = 0;
let currentTool = 'pen';
let currentColor = '#00d2ff';
let currentWidth = 4;
let strokeHistory = [];
let currentStroke = null;
let shapeSnapshot = null;
let lastEmitTime = 0;

const keys = { w: false, a: false, s: false, d: false, arrowup: false, arrowleft: false, arrowdown: false, arrowright: false };

window.addEventListener('keydown', (e) => {
    if (document.activeElement && (document.activeElement.tagName === 'INPUT' || document.activeElement.isContentEditable)) return;
    if (e.code === 'Space' && !spacePressed) {
        spacePressed = true;
        canvas.classList.add('pan-mode');
    }
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z') {
        e.preventDefault();
        socket.emit('undo_stroke', { room_id: ROOM_ID });
        return;
    }
    const k = e.key.toLowerCase();
    if (keys.hasOwnProperty(k)) keys[k] = true;
});

window.addEventListener('keyup', (e) => {
    if (e.code === 'Space') {
        spacePressed = false;
        isPanning = false;
        if (currentTool !== 'pan') canvas.classList.remove('pan-mode');
    }
    const k = e.key.toLowerCase();
    if (keys.hasOwnProperty(k)) keys[k] = false;
});

function keyboardPanLoop() {
    const speed = 14;
    let moved = false;
    if (keys.w || keys.arrowup) { panY += speed; moved = true; }
    if (keys.s || keys.arrowdown) { panY -= speed; moved = true; }
    if (keys.a || keys.arrowleft) { panX += speed; moved = true; }
    if (keys.d || keys.arrowright) { panX -= speed; moved = true; }
    if (moved) updateTransform();
    requestAnimationFrame(keyboardPanLoop);
}
keyboardPanLoop();

window.addEventListener('wheel', (e) => {
    if (e.target.closest('.floating-widget') || e.target.closest('.settings-overlay')) return;
    e.preventDefault();
    if (e.ctrlKey) {
        const zoomIntensity = 0.003;
        const delta = -e.deltaY * zoomIntensity;
        const newScale = Math.min(Math.max(0.25, window.workspaceScale + delta), 3);
        const mouseX = e.clientX;
        const mouseY = e.clientY;
        panX = mouseX - (mouseX - panX) * (newScale / window.workspaceScale);
        panY = mouseY - (mouseY - panY) * (newScale / window.workspaceScale);
        window.workspaceScale = newScale;
    } else {
        panX -= e.deltaX;
        panY -= e.deltaY;
    }
    updateTransform();
}, { passive: false });

const toolBtns = document.querySelectorAll('.tool-btn');
toolBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
        toolBtns.forEach(b => b.classList.remove('active'));
        e.currentTarget.classList.add('active');
        currentTool = e.currentTarget.id.replace('tool-', '');
        if (currentTool === 'pan') canvas.classList.add('pan-mode');
        else canvas.classList.remove('pan-mode');
    });
});

document.getElementById('color-picker').addEventListener('input', (e) => {
    currentColor = e.target.value;
});

const lineWidthInput = document.getElementById('line-width');
const lineWidthVal = document.getElementById('line-width-val');
lineWidthInput.addEventListener('input', (e) => {
    currentWidth = parseInt(e.target.value, 10) || 4;
    if (lineWidthVal) lineWidthVal.innerText = currentWidth + 'px';
});

document.getElementById('tool-undo').addEventListener('click', () => {
    socket.emit('undo_stroke', { room_id: ROOM_ID });
});

document.getElementById('tool-center').addEventListener('click', () => {
    window.centerWorkspace();
    if (window.showToast) window.showToast('Đã đưa bảng về vị trí trung tâm (100%)');
});

document.getElementById('tool-clear').addEventListener('click', () => {
    if (confirm('Bạn có chắc muốn xóa toàn bộ nét vẽ trên bảng không?')) {
        strokeHistory = [];
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        socket.emit('clear_board', { room_id: ROOM_ID });
    }
});

document.getElementById('tool-export').addEventListener('click', () => {
    const exportCanvas = document.createElement('canvas');
    exportCanvas.width = window.innerWidth;
    exportCanvas.height = window.innerHeight;
    const eCtx = exportCanvas.getContext('2d');
    eCtx.fillStyle = document.body.classList.contains('light-theme') ? '#f4f5f9' : '#0f0f13';
    eCtx.fillRect(0, 0, exportCanvas.width, exportCanvas.height);
    eCtx.save();
    eCtx.translate(panX, panY);
    eCtx.scale(window.workspaceScale, window.workspaceScale);
    eCtx.drawImage(canvas, 0, 0);
    eCtx.restore();
    const link = document.createElement('a');
    link.download = `SyncSpace_${ROOM_ID}_${Date.now()}.png`;
    link.href = exportCanvas.toDataURL('image/png');
    link.click();
    if (window.showToast) window.showToast('Đã tải ảnh bảng về máy!');
});

function hexToRgba(hex, alpha) {
    let c;
    if (/^#([A-Fa-f0-9]{3}){1,2}$/.test(hex)) {
        c = hex.substring(1).split('');
        if (c.length === 3) c = [c[0], c[0], c[1], c[1], c[2], c[2]];
        c = '0x' + c.join('');
        return 'rgba(' + [(c >> 16) & 255, (c >> 8) & 255, c & 255].join(',') + ',' + alpha + ')';
    }
    return hex;
}

function applyBrushSetting(tool, color, width) {
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.lineWidth = width;
    if (tool === 'eraser') {
        ctx.globalCompositeOperation = 'destination-out';
        ctx.strokeStyle = 'rgba(0,0,0,1)';
    } else if (tool === 'highlighter') {
        ctx.globalCompositeOperation = 'source-over';
        ctx.lineWidth = width * 2.8;
        ctx.strokeStyle = hexToRgba(color, 0.32);
    } else {
        ctx.globalCompositeOperation = 'source-over';
        ctx.strokeStyle = color;
    }
}

function drawSegmentImmediate(tool, color, width, x0, y0, x1, y1) {
    ctx.save();
    applyBrushSetting(tool, color, width);
    ctx.beginPath();
    ctx.moveTo(x0, y0);
    if (x0 === x1 && y0 === y1) {
        ctx.lineTo(x1 + 0.1, y1 + 0.1);
    } else {
        ctx.lineTo(x1, y1);
    }
    ctx.stroke();
    ctx.restore();
}

function drawShapeOnContext(tool, color, width, p0, p1) {
    ctx.save();
    applyBrushSetting(tool, color, width);
    ctx.beginPath();
    if (tool === 'line') {
        ctx.moveTo(p0.x, p0.y);
        ctx.lineTo(p1.x, p1.y);
    } else if (tool === 'rect') {
        ctx.strokeRect(p0.x, p0.y, p1.x - p0.x, p1.y - p0.y);
        ctx.restore();
        return;
    } else if (tool === 'circle') {
        const rx = Math.abs(p1.x - p0.x) / 2;
        const ry = Math.abs(p1.y - p0.y) / 2;
        const cx = (p0.x + p1.x) / 2;
        const cy = (p0.y + p1.y) / 2;
        ctx.ellipse(cx, cy, rx, ry, 0, 0, Math.PI * 2);
    }
    ctx.stroke();
    ctx.restore();
}

function renderStrokeObject(stroke) {
    if (!stroke) return;
    if (stroke.type === 'start' || stroke.type === 'move' || stroke.type === 'end') {
        if (stroke.type === 'start') {
            applyBrushSetting(stroke.tool, stroke.color, stroke.width);
            ctx.beginPath();
            ctx.moveTo(stroke.x, stroke.y);
        } else if (stroke.type === 'move') {
            ctx.lineTo(stroke.x, stroke.y);
            ctx.stroke();
        } else if (stroke.type === 'end') {
            ctx.closePath();
        }
        return;
    }
    const pts = stroke.points || [];
    if (pts.length === 0) return;
    if (stroke.tool === 'line' || stroke.tool === 'rect' || stroke.tool === 'circle') {
        if (pts.length >= 2) {
            drawShapeOnContext(stroke.tool, stroke.color, stroke.width, pts[0], pts[pts.length - 1]);
        }
        return;
    }
    ctx.save();
    applyBrushSetting(stroke.tool, stroke.color, stroke.width);
    ctx.beginPath();
    ctx.moveTo(pts[0].x, pts[0].y);
    if (pts.length === 1) {
        ctx.lineTo(pts[0].x + 0.1, pts[0].y + 0.1);
    } else {
        for (let i = 1; i < pts.length; i++) {
            ctx.lineTo(pts[i].x, pts[i].y);
        }
    }
    ctx.stroke();
    ctx.restore();
}

function redrawAllHistory() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    for (let i = 0; i < strokeHistory.length; i++) {
        renderStrokeObject(strokeHistory[i]);
    }
}

function getCanvasPos(clientX, clientY) {
    const rect = canvas.getBoundingClientRect();
    return {
        x: Math.round(((clientX - rect.left) / window.workspaceScale) * 10) / 10,
        y: Math.round(((clientY - rect.top) / window.workspaceScale) * 10) / 10
    };
}

function startPointerAction(clientX, clientY, button) {
    if (button === 1 || spacePressed || currentTool === 'pan') {
        isPanning = true;
        panStartX = clientX - panX;
        panStartY = clientY - panY;
        return;
    }
    if (button !== 0) return;
    drawing = true;
    const pos = getCanvasPos(clientX, clientY);
    currentStroke = {
        id: 'st_' + Date.now() + '_' + Math.floor(Math.random() * 1000),
        tool: currentTool,
        color: currentColor,
        width: currentWidth,
        points: [pos]
    };
    if (currentTool === 'line' || currentTool === 'rect' || currentTool === 'circle') {
        shapeSnapshot = ctx.getImageData(0, 0, canvas.width, canvas.height);
    } else {
        drawSegmentImmediate(currentTool, currentColor, currentWidth, pos.x, pos.y, pos.x, pos.y);
        socket.emit('draw_segment', {
            room_id: ROOM_ID,
            tool: currentTool,
            color: currentColor,
            width: currentWidth,
            x0: pos.x,
            y0: pos.y,
            x1: pos.x,
            y1: pos.y
        });
    }
}

function movePointerAction(clientX, clientY) {
    if (isPanning) {
        panX = clientX - panStartX;
        panY = clientY - panStartY;
        updateTransform();
        return;
    }
    if (!drawing || !currentStroke) return;
    const pos = getCanvasPos(clientX, clientY);
    const pts = currentStroke.points;
    const prev = pts[pts.length - 1];
    if (currentTool === 'line' || currentTool === 'rect' || currentTool === 'circle') {
        if (shapeSnapshot) ctx.putImageData(shapeSnapshot, 0, 0);
        drawShapeOnContext(currentTool, currentColor, currentWidth, pts[0], pos);
        if (pts.length === 1) pts.push(pos);
        else pts[1] = pos;
        return;
    }
    const distSq = (pos.x - prev.x) * (pos.x - prev.x) + (pos.y - prev.y) * (pos.y - prev.y);
    if (distSq < 1.5) return;
    drawSegmentImmediate(currentTool, currentColor, currentWidth, prev.x, prev.y, pos.x, pos.y);
    pts.push(pos);
    const now = Date.now();
    if (now - lastEmitTime > 16) {
        socket.emit('draw_segment', {
            room_id: ROOM_ID,
            tool: currentTool,
            color: currentColor,
            width: currentWidth,
            x0: prev.x,
            y0: prev.y,
            x1: pos.x,
            y1: pos.y
        });
        lastEmitTime = now;
    }
}

function endPointerAction() {
    if (isPanning) {
        isPanning = false;
        return;
    }
    if (!drawing || !currentStroke) return;
    drawing = false;
    shapeSnapshot = null;
    strokeHistory.push(currentStroke);
    socket.emit('draw_stroke', { room_id: ROOM_ID, stroke: currentStroke });
    currentStroke = null;
}

canvas.addEventListener('mousedown', (e) => {
    e.preventDefault();
    startPointerAction(e.clientX, e.clientY, e.button);
});

window.addEventListener('mousemove', (e) => {
    if (!drawing && !isPanning) return;
    movePointerAction(e.clientX, e.clientY);
});

window.addEventListener('mouseup', () => {
    endPointerAction();
});

canvas.addEventListener('touchstart', (e) => {
    if (e.touches.length === 1) {
        e.preventDefault();
        const t = e.touches[0];
        startPointerAction(t.clientX, t.clientY, 0);
    }
}, { passive: false });

canvas.addEventListener('touchmove', (e) => {
    if (e.touches.length === 1 && (drawing || isPanning)) {
        e.preventDefault();
        const t = e.touches[0];
        movePointerAction(t.clientX, t.clientY);
    }
}, { passive: false });

canvas.addEventListener('touchend', () => {
    endPointerAction();
});

window.loadDrawHistory = function(history) {
    strokeHistory = Array.isArray(history) ? history : [];
    redrawAllHistory();
};

socket.on('draw_segment', (d) => {
    drawSegmentImmediate(d.tool, d.color, d.width, d.x0, d.y0, d.x1, d.y1);
});

socket.on('draw_stroke', (stroke) => {
    strokeHistory.push(stroke);
    if (stroke.tool === 'line' || stroke.tool === 'rect' || stroke.tool === 'circle') {
        renderStrokeObject(stroke);
    }
});

socket.on('board_sync', (data) => {
    strokeHistory = data.draw_history || [];
    redrawAllHistory();
});

socket.on('board_cleared', () => {
    strokeHistory = [];
    ctx.clearRect(0, 0, canvas.width, canvas.height);
});
