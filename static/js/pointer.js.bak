const cursorsContainer = document.getElementById('cursors-container');
const cursors = {};
let lastSend = 0;

document.addEventListener('mousemove', (e) => {
const now = Date.now();
if (now - lastSend > 25) {
const rect = document.getElementById('workspace').getBoundingClientRect();
const wx = (e.clientX - rect.left) / window.workspaceScale;
const wy = (e.clientY - rect.top) / window.workspaceScale;
socket.emit('mouse_move', { room_id: ROOM_ID, x: wx, y: wy, username: USERNAME });
lastSend = now;
}
});

socket.on('mouse_update', (data) => {
if (!cursors[data.sid]) {
const el = document.createElement('div');
el.className = 'cursor';
el.innerHTML = '<div class="cursor-dot"></div><div class="cursor-name">' + data.username + '</div>';
cursorsContainer.appendChild(el);
cursors[data.sid] = el;
}
cursors[data.sid].style.transform = `translate(${data.x}px, ${data.y}px)`;
});

socket.on('user_disconnected', (data) => {
if (cursors[data.sid]) {
cursors[data.sid].style.opacity = '0';
setTimeout(() => {
if (cursors[data.sid]) { cursors[data.sid].remove(); delete cursors[data.sid]; }
}, 300);
}
});
