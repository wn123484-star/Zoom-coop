<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<title>SyncSpace - Quản trị hệ thống</title>
<link rel="stylesheet" href="/static/css/style.css">
</head>
<body style="background: #0f0f13; color: #fff; padding: 40px; overflow: auto;">
<div style="max-width: 850px; margin: 0 auto;">
<h1 style="color: #00d2ff; margin-bottom: 8px;">⚡ Bảng Điều Khiển Admin</h1>
<p style="color: #aaa; margin-top: 0;">Quản lý các phòng làm việc và giải phóng tài nguyên VPS.</p>
<div style="background: rgba(255,255,255,0.04); padding: 24px; border-radius: 16px; border: 1px solid rgba(255,255,255,0.08); margin-top: 20px;">
<h3 style="margin-top: 0;">Danh sách Phòng đã khởi tạo ({{ rooms|length }})</h3>
<ul style="list-style: none; padding: 0; margin: 0;">
{% for r, info in rooms.items() %}
<li style="display: flex; justify-content: space-between; align-items: center; padding: 14px 10px; border-bottom: 1px solid rgba(255,255,255,0.08);">
<div>
<strong style="color: #00d2ff; font-size: 16px;">Phòng: {{ r }}</strong>
<span style="margin-left: 12px; font-size: 13px; color: #55efc4;">👥 {{ info.user_count }} người đang online</span>
</div>
<form action="/api/admin/delete/{{ r }}" method="POST" style="margin:0; padding:0; width:auto; background:none; box-shadow:none; border:none; display:inline;">
<button type="submit" style="background: #ff4757; color: #fff; padding: 8px 16px; font-size: 13px; border-radius: 8px;">Xóa & Giải phóng</button>
</form>
</li>
{% else %}
<p style="color: #888;">Chưa có phòng nào đang hoạt động.</p>
{% endfor %}
</ul>
</div>
<a href="/" style="display: inline-block; margin-top: 25px; color: #00d2ff; text-decoration: none; font-weight: bold;">← Quay về Trang chủ</a>
</div>
</body>
</html>
