<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Admin Dashboard</title>
<link rel="stylesheet" href="/static/css/style.css">
</head>
<body style="background: #0f0f13; color: #fff; padding: 50px;">
<div style="max-width: 800px; margin: 0 auto;">
<h1 style="color: #ff4757;">Admin Dashboard</h1>
<p>Giới hạn hệ thống: Tối đa 3 phòng.</p>
<div style="background: rgba(255,255,255,0.05); padding: 20px; border-radius: 12px; margin-top: 20px;">
<h3>Danh sách Phòng đang hoạt động</h3>
<ul style="list-style: none; padding: 0;">
{% for r, info in rooms.items() %}
<li style="display: flex; justify-content: space-between; padding: 15px; border-bottom: 1px solid rgba(255,255,255,0.1);">
<span><strong>Room ID:</strong> {{ r }}</span>
<form action="/api/admin/delete/{{ r }}" method="POST" style="margin:0; padding:0; width:auto; background:none; box-shadow:none; border:none;">
<button type="submit" style="background: #ff4757; padding: 5px 15px; font-size: 13px;">Đóng Phòng</button>
</form>
</li>
{% else %}
<p style="color: #aaa;">Chưa có phòng nào đang hoạt động.</p>
{% endfor %}
</ul>
</div>
<a href="/" style="display: inline-block; margin-top: 30px; color: #00d2ff;">Về trang chủ</a>
</div>
</body>
</html>
